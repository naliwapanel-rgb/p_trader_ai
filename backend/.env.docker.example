# Docker Compose configuration template.
# Copy to .env.docker and replace every secret.
# Never commit .env.docker.

POSTGRES_DB=p_trader_ai
POSTGRES_USER=p_trader_user
POSTGRES_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS

SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

BACKEND_CORS_ORIGINS='["https://app.example.com"]'
TRUSTED_HOSTS='["api.example.com","127.0.0.1"]'
API_DOCS_ENABLED=false
SECURITY_HEADERS_ENABLED=true
WEB_CONCURRENCY=1
AUTOMATION_RUNTIME_ENABLED=true

NGINX_SERVER_NAME=api.example.com
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=10m
