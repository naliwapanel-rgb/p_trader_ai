# P-TRADER AI production configuration template.
# Copy this template into a secure secret-management system.
# Do not commit the completed production environment file.
APP_NAME=P-TRADER AI Backend
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend API for P-TRADER AI
ENVIRONMENT=production
DEBUG=false
WEB_CONCURRENCY=1
AUTOMATION_RUNTIME_ENABLED=true
# Replace during Phase 13B with the deployed PostgreSQL connection.
DATABASE_URL=postgresql+psycopg2://p_trader_user:REPLACE_ME@postgres:5432/p_trader_ai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Generate unique production values.
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Use JSON-list syntax and real HTTPS application origins.
BACKEND_CORS_ORIGINS=["https://app.example.com"]
# Keep live trading disabled during initial deployment.
EXCHANGE_TRADING_ENABLED=false
EXCHANGE_DRY_RUN=true
MAX_ORDER_QUANTITY=1.0
MAX_ORDER_VALUE_USD=25.0
AI_EXTERNAL_ENABLED=false
AI_PROVIDER=OPENAI_COMPATIBLE
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_NAME=
AI_REQUEST_TIMEOUT_SECONDS=20
