APP_NAME="P-TRADER AI Backend"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Backend API for P-TRADER AI"
ENVIRONMENT="development"
DEBUG=true

DATABASE_URL="sqlite:///./p_trader_ai.db"

SECRET_KEY="change-this-secret-key"
ENCRYPTION_KEY="change-this-fernet-key"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# External AI provider integration is disabled by default.
AI_EXTERNAL_ENABLED=false
AI_PROVIDER="OPENAI_COMPATIBLE"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL_NAME=""
AI_REQUEST_TIMEOUT_SECONDS=20
