# P-TRADER AI local development configuration.
# Copy this file to .env for local development only.
# Never use these development credentials in staging or production.
APP_NAME=P-TRADER AI Backend
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend API for P-TRADER AI
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./p_trader_ai.db
# Public development-only values.
# Production startup rejects both values.
SECRET_KEY=development-only-secret-key-change-before-production
ENCRYPTION_KEY=WokfjCgTZ0yVLZwYhDRQNS6nZ_CTX2O8eaIXq2IP0zg=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
# Live exchange trading remains disabled by default.
EXCHANGE_TRADING_ENABLED=false
EXCHANGE_DRY_RUN=true
MAX_ORDER_QUANTITY=1.0
MAX_ORDER_VALUE_USD=25.0
# External AI integration remains disabled by default.
AI_EXTERNAL_ENABLED=false
AI_PROVIDER=OPENAI_COMPATIBLE
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_NAME=
AI_REQUEST_TIMEOUT_SECONDS=20
